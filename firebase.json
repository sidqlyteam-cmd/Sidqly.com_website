{
  "hosting": {
    "site": "sidqly-15-june",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": false,
    "cleanUrls": true,
    "rewrites": [],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/demo",
        "destination": "/book-demo",
        "type": 301
      },
      {
        "source": "/how-sidqly-works",
        "destination": "/how-it-works",
        "type": 301
      },
      {
        "source": "/trust",
        "destination": "/trust-center",
        "type": 301
      }
    ]
  }
}