    },
    {
      "source": "/trust-and-dignity",
      "destination": "/modules/privacy-dignity-controls",
      "permanent": true
    },
    {
      "source": "/proof-trust-engine",
      "destination": "/modules/trust-and-dignity-engine",
      "permanent": true
    },
    {
      "source": "/verified-giving",
      "destination": "/modules/verified-giving",
      "permanent": true
    },
    {
      "source": "/manual-payment-review",
      "destination": "/modules/manual-payment-review",
      "permanent": true
    },
    {
      "source": "/donor-safe-impact",
      "destination": "/modules/donor-safe-updates",
