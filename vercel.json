{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/demo",
      "destination": "/book-demo",
      "permanent": true
    },
    {
      "source": "/how-sidqly-works",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/trust",
      "destination": "/trust-center",
      "permanent": true
    },
    {
      "source": "/locations/north-america",
      "destination": "/regions/north-america",
      "permanent": true
    },
    {
      "source": "/locations/europe",
      "destination": "/regions/europe",
      "permanent": true
    },
    {
      "source": "/locations/middle-east",
      "destination": "/regions/gulf-mena",
      "permanent": true
    },
    {
      "source": "/locations/south-asia",
      "destination": "/regions/south-asia",
      "permanent": true
    },
    {
      "source": "/locations/asia-pacific",
      "destination": "/regions/asia-pacific",
      "permanent": true
    },
    {
      "source": "/locations/africa",
      "destination": "/regions/africa",
      "permanent": true
    },
    {
      "source": "/(ar|ur|fr|de)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(ar|ur|fr|de)/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(ar|ur|fr|de)/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
