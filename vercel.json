    },
    {
      "source": "/qurbani-management-software",
      "destination": "/solutions/qurbani-organizers",
      "permanent": true
    },
    {
      "source": "/ramadan-donation-management",
      "destination": "/solutions/ramadan-campaigns",
      "permanent": true
    },
    {
      "source": "/charity-request-management",
      "destination": "/modules/charity-request-intake",
      "permanent": true
    },
    {
      "source": "/vendor-fulfillment-platform",
      "destination": "/modules/vendor-management",
      "permanent": true
    },
    {
      "source": "/mosque-donation-management",
      "destination": "/use-cases/mosques",
      "permanent": true
    },
    {
      "source": "/compare/:slug(.*-alternatives)",
      "destination": "/alternatives/:slug",
      "permanent": true
    },
    {
      "source": "/alternatives/:slug(sidqly-vs-.*)",
      "destination": "/compare/:slug",
      "permanent": true
    },
    {
      "source": "/alternatives/launchgood",
      "destination": "/alternatives/launchgood-alternatives",
      "permanent": true
    },
    {
      "source": "/alternatives/donorbox",
      "destination": "/alternatives/donorbox-alternatives",
      "permanent": true
    },
    {
      "source": "/alternatives/qurbanapp",
      "destination": "/alternatives/qurbanapp-alternatives",
      "permanent": true
    },
    {
      "source": "/alternatives/zakat-management-software",
      "destination": "/alternatives/zakat-management-software-alternatives",
      "permanent": true
    },
    {
      "source": "/compare/atiyat-box",
      "destination": "/compare/sidqly-vs-atiyat-box",
      "permanent": true
    },
    {
      "source": "/(ar|ur|fr|de)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(ar|ur|fr|de)/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(ar|ur|fr|de)/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
